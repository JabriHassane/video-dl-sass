# Secrets — .env holds COOKIE_SECRET, JWT_SECRET and the database
# password. Anyone with JWT_SECRET can mint an ADMIN token, so this file
# must never reach the repository. Use .env.example as the template.
.env
.env.local
.env.*.local

# Cookie exports for login-gated platforms: these are live session
# credentials for a real account.
cookies.txt
*.cookies.txt

# Dependencies — restored with `npm install`.
node_modules/

# Build output
frontend/dist/
dist/
build/

# Logs and runtime noise
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
