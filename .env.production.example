# Production reference values for the Ubuntu server deployment.
# Copy to `.env` next to docker-compose.prod.yml, fill in the blanks, then
# `chmod 600 .env`. Do NOT reuse the dev secrets from .env.example.

# openssl rand -base64 48
COOKIE_SECRET=
POSTGRES_PASSWORD=
# openssl rand -base64 48 — anyone who knows this can mint an ADMIN token.
JWT_SECRET=

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Swagger UI at /docs — free reconnaissance in production, keep this false.
EXPOSE_DOCS=false

COOKIE_SECURE=true

# nginx is the only reverse proxy in front of the app in prod.
TRUSTED_PROXY_COUNT=1

# The public hostname, reverse-proxied by nginx (see DEPLOY.md) — same
# origin the browser loads the app from, so no cross-site cookie issues.
FRONTEND_ORIGINS=https://videodl.azwebtech.net
VITE_API_URL=https://videodl.azwebtech.net

# --- Login-gated platforms (Instagram, Facebook, often TikTok) ---------
# Leave both empty to run without them — see .env.example for details.
COOKIES_HOST_PATH=
YTDLP_COOKIES_FILE=
