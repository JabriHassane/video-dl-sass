# Copy to .env and fill in real values before running docker compose.
COOKIE_SECRET=replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-with-a-strong-password

# Signs every access/refresh JWT. Use a long random value — anyone who
# knows it can mint an ADMIN token. Kept separate from COOKIE_SECRET so it
# can be rotated alone; rotating it signs every user out immediately,
# which is the emergency lever after a suspected key compromise.
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Access token lifetime in seconds. Also the worst-case delay before a
# role change or a ban takes effect, since /api/auth/refresh is what
# re-reads the user row. Shorter = safer but more refresh traffic.
ACCESS_TOKEN_TTL=900
# Refresh token lifetime in seconds — how long "stay signed in" lasts.
REFRESH_TOKEN_TTL=2592000

# Swagger UI at /docs publishes the whole API surface. Fine while
# developing, free reconnaissance in production: set to false there.
EXPOSE_DOCS=true

# Set to false only for local HTTP testing without a TLS-terminating proxy.
COOKIE_SECURE=true

# Number of trusted reverse-proxy hops in front of the app (Cloudflare/nginx).
TRUSTED_PROXY_COUNT=1

# CORS: origins allowed to call the API with credentials (the React SPA).
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Baked into the frontend build — must be reachable from the *browser*,
# not just from inside the docker network (so "app:8080" won't work here).
VITE_API_URL=http://localhost:8080

# --- Login-gated platforms (Instagram, Facebook, often TikTok) ---------
# These refuse anonymous requests, so yt-dlp needs a logged-in session.
# Export your browser cookies in Netscape format, then set BOTH:
#   COOKIES_HOST_PATH=/absolute/path/on/host/cookies.txt
#   YTDLP_COOKIES_FILE=/run/secrets/cookies.txt
# Leave both empty to run without them — those platforms will simply
# return "contenu privé ou protégé" instead of downloading.
# The file is mounted read-only and never stored in the database.
COOKIES_HOST_PATH=
YTDLP_COOKIES_FILE=
